# Commission Quote App environment knobs (defaults shown; copy to .env to override)
PORT_FRONTEND=3000
PORT_BACKEND=8000
PORT_VENDOR=8001
VENDOR_API_KEY=dev-vendor-secret
# FAULT_RATE is a FRACTION in [0,1]: 0.2 -> 80% ok / 10% 500 / 5% 400 / 5% latency-504
FAULT_RATE=0.2
VENDOR_LATENCY_MIN_MS=100
VENDOR_LATENCY_MAX_MS=2000

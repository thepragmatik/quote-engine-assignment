<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
  <!-- Security Note: CorrelationIdFilter validates the inbound X-Request-ID against a strict
       safe regex ^[a-zA-Z0-9_.-]{1,64}$ and sanitizes CRLF before reflecting it onto the response header. -->
  <Match>
    <Class name="com.bendigo.vendor.CorrelationIdFilter"/>
    <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
  </Match>
</FindBugsFilter>

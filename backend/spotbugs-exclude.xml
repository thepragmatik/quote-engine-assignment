<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
  <!-- Configuration-properties records are immutable carriers bound by Spring; the Map
       component is populated by the framework and never mutated. -->
  <Match>
    <Class name="com.bendigo.quote.domain.RiskBandMatrix"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Security Note: constructor throws on a hostile/misconfigured VENDOR_API_URL
       BEFORE any field is published (no finalizer exposure is possible: the class holds
       no finalize() and Spring never registers it for finalization). Fail-fast beats
       half-constructed service. -->
  <Match>
    <Class name="com.bendigo.quote.resilience.VendorApiClientAdapter"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <Match>
    <Class name="com.bendigo.quote.domain.MatrixCommissionStrategy"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <!-- Security Note: CorrelationIdFilter validates the inbound X-Request-ID against a strict
       safe regex ^[a-zA-Z0-9_.-]{1,64}$ and sanitizes CRLF before reflecting it onto the response header. -->
  <Match>
    <Class name="com.bendigo.quote.config.CorrelationIdFilter"/>
    <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
  </Match>
</FindBugsFilter>
